<resources>
    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="CalcButtonDigit" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_digit</item>
        <item name="android:textColor">@color/calc_digit_text</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_operator</item>
        <item name="android:textColor">@color/calc_operator_text</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_function</item>
        <item name="android:textColor">@color/calc_function_text</item>
    </style>
</resources>
