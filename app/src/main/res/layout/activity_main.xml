<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background">

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="end"
        android:textSize="20sp"
        android:textColor="@color/calc_expression_text"
        android:maxLines="1"
        android:ellipsize="start" />

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:textSize="56sp"
        android:textColor="@color/calc_display_text"
        android:text="0"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeMaxTextSize="56sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout style="@style/CalcRow">
            <Button android:id="@+id/btnClear" style="@style/CalcButtonFunction" android:text="C" />
            <Button android:id="@+id/btnBackspace" style="@style/CalcButtonFunction" android:text="⌫" />
            <Button android:id="@+id/btnPercent" style="@style/CalcButtonFunction" android:text="%" />
            <Button android:id="@+id/btnDivide" style="@style/CalcButtonOperator" android:text="÷" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button android:id="@+id/btn7" style="@style/CalcButtonDigit" android:text="7" />
            <Button android:id="@+id/btn8" style="@style/CalcButtonDigit" android:text="8" />
            <Button android:id="@+id/btn9" style="@style/CalcButtonDigit" android:text="9" />
            <Button android:id="@+id/btnMultiply" style="@style/CalcButtonOperator" android:text="×" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button android:id="@+id/btn4" style="@style/CalcButtonDigit" android:text="4" />
            <Button android:id="@+id/btn5" style="@style/CalcButtonDigit" android:text="5" />
            <Button android:id="@+id/btn6" style="@style/CalcButtonDigit" android:text="6" />
            <Button android:id="@+id/btnMinus" style="@style/CalcButtonOperator" android:text="−" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button android:id="@+id/btn1" style="@style/CalcButtonDigit" android:text="1" />
            <Button android:id="@+id/btn2" style="@style/CalcButtonDigit" android:text="2" />
            <Button android:id="@+id/btn3" style="@style/CalcButtonDigit" android:text="3" />
            <Button android:id="@+id/btnPlus" style="@style/CalcButtonOperator" android:text="+" />
        </LinearLayout>

        <LinearLayout style="@style/CalcRow">
            <Button
                android:id="@+id/btn0"
                style="@style/CalcButtonDigit"
                android:layout_weight="2"
                android:text="0" />
            <Button android:id="@+id/btnDot" style="@style/CalcButtonDigit" android:text="." />
            <Button android:id="@+id/btnEquals" style="@style/CalcButtonOperator" android:text="=" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
